  "parent_uuid": "1cc0f115-70d2-46ea-b00e-3796aa291c7b",
  "unlisted": false,
  "date": 1790900253,
  "creator": "alistair",
  "title": "Alistair's Layout",
  "notes": "Continuing to be changed in response to Emacs/Extempore ambitions.\n- Increased autoshift duration from 200 to 230\n- Set up some personal keys.\n- Layer 1 The LG(T) right thumb is for Latex Typesetting.\n- Setting up layer for Extempore Emacs control.\n- Layers 3 and 4 can be used for Extempore/Emacs functions.\n- LEDs flash when new layer is toggle on and flash when it's toggled off\n- Extempore Eval is flashed when executed.",
  "tags": [
    "auto-shift",
    "custom"
  ],
  "custom_defined_behaviors": "behaviors {\n    as: auto_shift {\n        compatible = \"zmk,behavior-hold-tap\";\n        label = \"AUTO_SHIFT\";\n        #binding-cells = <2>;\n        tapping_term_ms = <350>;\n        quick_tap_ms = <0>;\n        flavor = \"tap-preferred\";\n        bindings = <&kp>, <&kp>;\n    };\n    es: execute_snippet {\n        compatible = \"zmk,behavior-hold-tap\";\n        label = \"EXECUTE_SNIPPET\";\n        #binding-cells = <2>;\n        tapping_term_ms = <350>;\n        quick_tap_ms = <0>;\n        flavor = \"tap-preferred\";\n        bindings = <&execute_snippet>, <&kp>;\n    };\n    ac: app_cycle {\n        compatible = \"zmk,behavior-hold-tap\";\n        label = \"APP_CYCLE\";\n        #binding-cells = <2>;\n        tapping_term_ms = <10>;\n        quick_tap_ms = <0>;\n        flavor = \"tap-preferred\";\n        bindings = <&execute_snippet>, <&kp>;\n    };\n};",
